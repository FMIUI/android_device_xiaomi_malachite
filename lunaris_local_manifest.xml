<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote name="lineageos-up" fetch="https://github.com/LineageOS/" />
  <remote name="fmiui" fetch="https://github.com/FMIUI/" />
  <remote name="malachite-project" fetch="https://github.com/malachite-project/" />

  <!-- Device (your FMIUI fork) -->
  <remove-project path="device/xiaomi/malachite" optional="true" />
  <project path="device/xiaomi/malachite" name="android_device_xiaomi_malachite" remote="fmiui" revision="lineage-23.2" />

  <!-- Kernel (prebuilt), vendor -->
  <remove-project path="device/xiaomi/malachite-kernel" optional="true" />
  <project path="device/xiaomi/malachite-kernel" name="android_device_xiaomi_malachite-kernel" remote="fmiui" revision="lineage-23.2" />
  <remove-project path="vendor/xiaomi/malachite" optional="true" />
  <project path="vendor/xiaomi/malachite" name="proprietary_vendor_xiaomi_malachite" remote="fmiui" revision="lineage-23.2" />

  <!-- Platform -->
  <remove-project path="hardware/mediatek" optional="true" />
  <project path="hardware/mediatek" name="android_hardware_mediatek" remote="fmiui" revision="lineage-23.2" />
  <remove-project path="hardware/xiaomi" optional="true" />
  <project path="hardware/xiaomi" name="android_hardware_xiaomi" remote="lineageos-up" revision="lineage-23.2" />
  <remove-project path="device/mediatek/sepolicy_vndr" optional="true" />
  <project path="device/mediatek/sepolicy_vndr" name="android_device_mediatek_sepolicy_vndr" remote="fmiui" revision="3865c6e1098175ca1082cdafb45d82a805ec7d00" upstream="lineage-23.2" />
  <remove-project path="vendor/mediatek/ims" optional="true" />
  <project path="vendor/mediatek/ims" name="android_vendor_mediatek_ims" remote="malachite-project" revision="06c462f1dfc2bb62e70e1d827b14bb364dc97857" upstream="lineage-24.0" />

  <!-- Dolby control app -->
  <remove-project path="hardware/dolby" optional="true" />
  <project path="hardware/dolby" name="android_hardware_dolby" remote="fmiui" revision="lineage-23.2" />
</manifest>
