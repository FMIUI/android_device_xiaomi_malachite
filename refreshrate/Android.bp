// Gives each user a minimum refresh rate of 60 Hz until they pick one in
// Settings > Display > Minimum refresh rate.
android_app {
    name: "MalachiteRefreshRate",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    system_ext_specific: true,
    platform_apis: true,
}
